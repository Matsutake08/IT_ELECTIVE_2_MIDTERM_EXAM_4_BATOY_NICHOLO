@model LaboratorySession
@{
    ViewData["Title"] = "Session Details";
}

<h2>Session Details</h2>
<dl class="row">
    <dt class="col-sm-3">Session Number</dt><dd class="col-sm-9">@Model.SessionNumber</dd>
    <dt class="col-sm-3">Student Number</dt><dd class="col-sm-9">@Model.StudentNumber</dd>
    <dt class="col-sm-3">Student Name</dt><dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>
    <dt class="col-sm-3">Course / Year</dt><dd class="col-sm-9">@Model.Course / @Model.YearLevel</dd>
    <dt class="col-sm-3">Computer Number</dt><dd class="col-sm-9">@Model.ComputerNumber</dd>
    <dt class="col-sm-3">Purpose</dt><dd class="col-sm-9">@Model.Purpose</dd>
    <dt class="col-sm-3">Time In</dt><dd class="col-sm-9">@Model.TimeIn.ToString("MMM dd, yyyy hh:mm tt")</dd>
    <dt class="col-sm-3">Time Out</dt><dd class="col-sm-9">@(Model.TimeOut?.ToString("MMM dd, yyyy hh:mm tt") ?? "-")</dd>
    <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
    <dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@(Model.Notes ?? "-")</dd>
</dl>
<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-secondary" asp-action="Index">Back</a>
